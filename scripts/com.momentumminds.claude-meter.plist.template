<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. install.sh substitutes __ROOT__ and __HOME__ and writes the result
  to ~/Library/LaunchAgents/. launchd plists cannot expand ~ or $HOME, so the
  paths have to be absolute -- which is exactly why this is a template rather
  than a checked-in plist with someone's home directory baked into it.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.momentumminds.claude-meter</string>

  <!-- Launch the executable inside the bundle rather than `open`ing the app:
       launchd can then supervise the process directly, and KeepAlive means a
       crash brings the menubar item straight back. The bundle still supplies
       LSUIElement because the binary lives inside it. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/dist/ClaudeMeter.app/Contents/MacOS/ClaudeMeter</string>
  </array>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>

  <key>StandardOutPath</key><string>__HOME__/Library/Logs/claude-meter.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/claude-meter.log</string>
</dict>
</plist>
