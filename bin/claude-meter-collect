#!/bin/bash
# claude-meter collector.
#
# Runs as a Claude Code statusLine command. Claude Code pipes the session JSON
# to stdin; this script does two things with it:
#
#   1. Publishes a per-session snapshot to the state directory, so surfaces
#      outside Claude Code (the ClaudeMeter menubar app) can read usage without
#      a live session of their own. This is the only channel that exists --
#      rate_limits are delivered to the status line and nowhere else.
#   2. Appends one line to a history trail, because the snapshot is a
#      point-in-time overwrite and the SessionEnd hook deletes it. Without a
#      trail nothing about the past survives, which makes burn rate and "will
#      this task outlive the window" unanswerable rather than merely awkward.
#   3. Prints a one-line HUD to stdout, which Claude Code renders.
#
# It is invoked indirectly: the kickbacks ad status line owns the statusLine
# slot in settings.json and chains to whatever is named in
# ~/.kickbacks/cli-prev-statusline.json, spawning it with stdin inherited. That
# chain has a 3s deadline and a 64KB stdout cap, both of which this stays far
# inside.
#
# Failure policy: never break the status line. Every path exits 0, and a
# missing field degrades the HUD rather than aborting it.

set -u

# Every number this script formats is machine-facing, so it is pinned to the C
# numeric locale. Under a comma-decimal locale printf both misparses "8.34" as 8
# and prints the result back as "8,00", which is what most of Europe would see
# on every assistant message.
#
# Two subtleties: LC_ALL overrides every LC_* variable, so it has to go before
# LC_NUMERIC can take effect; and bash only re-reads its locale on a real
# assignment, so the `LC_ALL=C printf` prefix form silently does nothing to the
# builtin. Only LC_NUMERIC is forced -- LC_CTYPE is left alone so session names
# keep whatever encoding the user's shell gave them.
unset LC_ALL
export LC_NUMERIC=C

# Resolved from PATH, not hardcoded to /usr/bin/jq: a Homebrew jq is the common
# case on older macOS, and without this the collector silently does nothing
# forever with no symptom but an empty menubar item.
JQ="$(command -v jq || true)"
STATE="${CLAUDE_METER_STATE:-$HOME/.local/state/claude-meter}"
SESSIONS="$STATE/sessions"
HISTORY="$STATE/history.jsonl"
MAX_AGE_MIN=1440

# History trail knobs, all in the units they are compared against.
#
# One sample a minute is the sampling grid. It is finer than anything a 5-hour
# or 7-day bar can usefully resolve, and coarse enough that a fully saturated
# week costs about 1.2 MB -- while still being the natural unit for a status
# line that can fire several times a second when Claude Code is mid-answer.
#
# Eight days of retention rather than seven: the 7-day window is a rolling one,
# so a trail cut at exactly seven days would be one line short of covering it
# for every moment except the instant after a trim. The extra day is the margin
# that makes "the whole 7-day window" always true.
#
# The byte cap is a backstop, not the retention rule. It only decides *when* it
# is worth paying for a rewrite; HISTORY_MAX_AGE_SEC decides what survives one.
# At the sampling grid above, eight days is ~11.5k lines and ~1.3 MB, so a 2 MB
# trigger means a trim happens rarely and always has real work to do.
HISTORY_INTERVAL=60
HISTORY_MAX_AGE_SEC=691200
HISTORY_MAX_LINES=20000
HISTORY_MAX_BYTES=2000000
HISTORY_MAX_LINE=512

input=$(cat)

# No jq, or nothing on stdin: print nothing and get out of the way.
[ -n "$JQ" ] || exit 0
[ -n "$input" ] || exit 0

# A state directory that cannot be created is survivable, and used to not be:
# this exited 0 before printing anything, so an unwritable $HOME took the HUD
# down with the snapshots. The HUD is the half the user actually looks at and it
# needs nothing from disk, so the failure is allowed through. Every write below
# is individually guarded and degrades to a no-op on its own.
#
# That makes a failing open() reachable for the first time, so every write from
# here down puts `2>/dev/null` *before* its output redirection. Bash applies
# redirections left to right and reports a failed one on whatever fd 2 is at
# that instant, so the familiar trailing form would let "No such file or
# directory" through to the terminal on exactly the paths this is meant to
# survive.
mkdir -p "$SESSIONS" 2>/dev/null || true

# Keep the last raw payload. Claude Code's status line schema gains fields
# between releases (rate_limits carries undocumented windows in 2.1.224), so
# having the real thing on disk beats guessing from the docs.
printf '%s' "$input" 2>/dev/null > "$STATE/last-raw.json.tmp.$$" &&
  mv -f "$STATE/last-raw.json.tmp.$$" "$STATE/last-raw.json" 2>/dev/null
rm -f "$STATE/last-raw.json.tmp.$$" 2>/dev/null

now=$(date +%s)

# Normalize into a stable shape. rate_limits is passed through whole rather
# than picked apart: the CLI spreads its raw object, so it carries windows
# beyond the two documented ones and we want them preserved for the app.
snapshot=$(printf '%s' "$input" | "$JQ" -c --argjson ts "$now" '
{
  ts: $ts,
  session_id:   (.session_id // "unknown"),
  session_name: (.session_name // null),
  cwd:          (.workspace.current_dir // .cwd // null),
  project_dir:  (.workspace.project_dir // null),
  # Recorded so the app can tell "this session is working" from "this session
  # has stopped". The status line only fires on assistant messages, so a
  # session that dispatches a long subagent goes quiet here while it is very
  # much alive -- observed at 3h between refreshes on a session whose
  # transcript had been appended 18 minutes earlier. The transcript keeps
  # growing throughout, so its mtime is the honest activity signal. The path
  # is stored rather than a timestamp because the useful reading is the one
  # taken when the app looks, not the one taken when this last ran.
  transcript:   (.transcript_path // null),
  model:        (.model.display_name // null),
  model_id:     (.model.id // null),
  version:      (.version // null),
  effort:       (.effort.level // null),
  fast_mode:    (.fast_mode // false),
  context: {
    used_percentage:      (.context_window.used_percentage // null),
    remaining_percentage: (.context_window.remaining_percentage // null),
    total_input_tokens:   (.context_window.total_input_tokens // 0),
    total_output_tokens:  (.context_window.total_output_tokens // 0),
    size:                 (.context_window.context_window_size // null),
    current_usage:        (.context_window.current_usage // null)
  },
  exceeds_200k: (.exceeds_200k_tokens // false),
  cost: {
    total_cost_usd:        (.cost.total_cost_usd // 0),
    total_duration_ms:     (.cost.total_duration_ms // 0),
    total_api_duration_ms: (.cost.total_api_duration_ms // 0),
    lines_added:           (.cost.total_lines_added // 0),
    lines_removed:         (.cost.total_lines_removed // 0)
  },
  rate_limits: (.rate_limits // null)
}' 2>/dev/null)

# Malformed JSON on stdin: nothing useful to publish or print.
[ -n "$snapshot" ] || exit 0

sid=$(printf '%s' "$snapshot" | "$JQ" -r '.session_id' 2>/dev/null)
# Session ids are UUIDs, but this becomes a filename -- refuse anything that
# is not already path-safe rather than sanitizing a surprise into place.
case "$sid" in
  ''|*/*|*..*) sid="unknown" ;;
esac

tmp="$SESSIONS/.$sid.json.tmp.$$"
if printf '%s\n' "$snapshot" 2>/dev/null > "$tmp"; then
  # rename() is atomic on APFS, so the app never observes a half-written file.
  mv -f "$tmp" "$SESSIONS/$sid.json" 2>/dev/null || rm -f "$tmp" 2>/dev/null
fi

# Sweep snapshots left behind by sessions that died without a SessionEnd hook.
# Deliberately scoped to $SESSIONS and to *.json: history.jsonl sits one level
# up and does not match either, and it must not -- it is the one file here whose
# whole value is being old.
find "$SESSIONS" -type f -name '*.json' -mmin +"$MAX_AGE_MIN" -delete 2>/dev/null

# ----------------------------------------------------------- history trail --
#
# The 5-hour and 7-day windows are properties of the account, not of a session,
# so every session that is open right now sees the same two numbers and would
# otherwise each write them. Three concurrent sessions mid-answer would append
# several near-identical lines a second, which is noise that costs disk and buys
# nothing: the underlying numbers move on the order of minutes.
#
# So the trail is sampled on a fixed one-minute grid rather than throttled per
# process, and a bucket is claimed before any work is done. Claiming is a stamp
# file created with O_EXCL -- which is exactly what `>` becomes under noclobber
# -- because that is the cheapest atomic test-and-set a shell has: no fork, no
# lock to release, and nothing left holding a lock if this process is killed
# between the claim and the write. Whoever gets there first in a given minute
# gets a zero exit and does the work; everyone else pays one failed open().
#
# A grid rather than "60s since the last append" also means the samples land at
# predictable instants, which is what a sparkline and a slope both want. The one
# thing it gives up is that two refreshes straddling a boundary can be seconds
# apart -- harmless, and far cheaper than the alternative, which is reading the
# tail of the file on every status line refresh to find out when the last append
# was.
slot="$STATE/.history-slot.$(( now / HISTORY_INTERVAL ))"
set -C
if true 2>/dev/null > "$slot"; then claimed=1; else claimed=0; fi
set +C

if [ "$claimed" = 1 ]; then
  # Built from the snapshot with its own jq pass rather than reused from the HUD
  # extraction below, which is only affordable because it runs once a minute
  # instead of once a refresh. The HUD flattens every absent field to the string
  # "-" and every percentage to its integer part, and both are lossy in ways
  # that matter here: this file is the record, and "absent" has to stay
  # distinguishable from 0 in it, not just on screen.
  #
  # A payload with no rate_limits at all -- Console billing, or a session whose
  # first API response has not landed -- produces no line rather than a line of
  # zeros. One window present and the other missing produces an explicit null,
  # for the same reason. -a forces pure ASCII out of jq so the length check
  # below counts bytes and characters as the same thing.
  line=$(printf '%s' "$snapshot" | "$JQ" -c -a --argjson ts "$now" '
    (.rate_limits // {}) as $r
    | ($r.five_hour // {}) as $f
    | ($r.seven_day // {}) as $s
    | if $f.used_percentage == null and $s.used_percentage == null then empty
      else {
        ts:              $ts,
        five_hour_pct:   $f.used_percentage,
        five_hour_reset: $f.resets_at,
        seven_day_pct:   $s.used_percentage,
        seven_day_reset: $s.resets_at
      }
      end' 2>/dev/null)

  # Appending is not the snapshot's write-then-rename problem: there is no whole
  # file to swap, only a line to add to one other processes may be adding to at
  # the same moment. What makes that safe is O_APPEND, which `>>` sets: POSIX
  # requires the seek-to-end and the write to be one indivisible step, so two
  # appenders can interleave lines but never characters. That guarantee only
  # holds for a single write() call, which is why the line is checked against
  # HISTORY_MAX_LINE first -- a real line is ~113 bytes, 512 is under both the
  # 512-byte PIPE_BUF on macOS and stdio's buffer, and anything longer than that
  # is a payload doing something unexpected and is dropped rather than risked.
  if [ -n "$line" ] && [ "${#line}" -le "$HISTORY_MAX_LINE" ]; then
    printf '%s\n' "$line" 2>/dev/null >> "$HISTORY"
  fi

  # Trimming is the one operation here that rewrites the file, so it is kept off
  # the hot path twice over: it can only run inside a claimed bucket, and only
  # when the file has grown past a cap a healthy week never reaches. The cost of
  # deciding not to trim is one stat().
  size=$(wc -c < "$HISTORY" 2>/dev/null)
  size="${size//[!0-9]/}"
  [ -n "$size" ] || size=0
  if [ "$size" -gt "$HISTORY_MAX_BYTES" ]; then
    # tail first, so the line ceiling is enforced by reading a bounded tail
    # rather than the whole file, then awk drops anything past the age cutoff.
    # awk rather than jq on purpose: jq aborts the whole stream on one malformed
    # line, and a line torn by a crash mid-append is precisely the thing a trim
    # should be quietly discarding. Anything without a well-formed leading ts is
    # not a record this wrote and does not survive.
    htmp="$STATE/.history.jsonl.tmp.$$"
    if tail -n "$HISTORY_MAX_LINES" "$HISTORY" 2>/dev/null |
       awk -v cutoff=$(( now - HISTORY_MAX_AGE_SEC )) '
         match($0, /"ts":[0-9]+/) &&
         substr($0, RSTART + 5, RLENGTH - 5) + 0 >= cutoff' 2>/dev/null > "$htmp"
    then
      # A concurrent appender holding the old inode loses at most its own line
      # here. That is the accepted cost of not taking a lock: a trim happens on
      # the order of days, and the alternative failure -- a reader seeing a
      # half-rewritten file -- is the one worth ruling out.
      mv -f "$htmp" "$HISTORY" 2>/dev/null
    fi
    rm -f "$htmp" 2>/dev/null
  fi

  # The stamp files are the only litter this leaves in the normal case, and a
  # trim killed between writing its temp file and renaming it is the abnormal
  # one -- worth sweeping too, because that temp is megabytes rather than zero
  # bytes. Doing it from inside the claimed branch keeps it off the hot path,
  # and the two-minute floor means neither a stamp nor a temp another process is
  # still working under is ever a candidate.
  find "$STATE" -maxdepth 1 -type f \
    \( -name '.history-slot.*' -o -name '.history.jsonl.tmp.*' \) \
    -mmin +2 -delete 2>/dev/null
fi

# ---------------------------------------------------------------- HUD line --

# Tab-separated so empty fields survive the split. "-" marks absent.
IFS=$'\t' read -r f_pct f_reset s_pct s_reset c_pct c_tok c_size cost_usd <<EOF
$(printf '%s' "$snapshot" | "$JQ" -r '
  def d: if . == null then "-" else tostring end;
  [ (.rate_limits.five_hour.used_percentage  | d),
    (.rate_limits.five_hour.resets_at        | d),
    (.rate_limits.seven_day.used_percentage  | d),
    (.rate_limits.seven_day.resets_at        | d),
    (.context.used_percentage                | d),
    (.context.total_input_tokens             | d),
    (.context.size                           | d),
    (.cost.total_cost_usd                    | d)
  ] | @tsv' 2>/dev/null)
EOF

DIM=$'\033[2m'; RST=$'\033[0m'
GRN=$'\033[32m'; YLW=$'\033[33m'; RED=$'\033[31m'

# Percentages arrive as floats (23.5). Bash has no float compare, and the
# integer part is all a threshold needs.
int() { local v="${1%%.*}"; case "$v" in ''|*[!0-9-]*) echo "" ;; *) echo "$v" ;; esac; }

# Thresholds match the app's mood states: calm / pacing / wind down.
color_for() {
  local n; n=$(int "$1")
  [ -n "$n" ] || { printf '%s' "$DIM"; return; }
  if   [ "$n" -ge 80 ]; then printf '%s' "$RED"
  elif [ "$n" -ge 50 ]; then printf '%s' "$YLW"
  else                       printf '%s' "$GRN"
  fi
}

# Seconds until a reset, as a coarse "3h12m" / "47m". Absent or already
# elapsed renders as nothing rather than a negative countdown.
countdown() {
  local at="$1" secs h m
  [ "$at" != "-" ] || return
  at=$(int "$at"); [ -n "$at" ] || return
  secs=$(( at - now )); [ "$secs" -gt 0 ] || return
  h=$(( secs / 3600 )); m=$(( (secs % 3600) / 60 ))
  if [ "$h" -gt 0 ]; then printf '%dh%02dm' "$h" "$m"; else printf '%dm' "$m"; fi
}

# 76000 -> "76k", 1000000 -> "1M" (the extended context window).
ktok() {
  local n; n=$(int "$1")
  [ -n "$n" ] || { printf '%s' "?"; return; }
  if   [ "$n" -ge 1000000 ]; then printf '%dM' $(( n / 1000000 ))
  elif [ "$n" -ge 1000 ];    then printf '%dk' $(( n / 1000 ))
  else                            printf '%d' "$n"
  fi
}

seg=""

# 5-hour window. Absent for non-subscribers and before the session's first API
# response, in which case it is shown dimmed rather than dropped -- a missing
# segment reads as "fine" and this is the number worth noticing.
if [ "$f_pct" != "-" ]; then
  left=$(countdown "$f_reset")
  seg="${seg}$(color_for "$f_pct")5h $(int "$f_pct")%${RST}"
  [ -n "$left" ] && seg="${seg} ${DIM}·${left}${RST}"
else
  seg="${seg}${DIM}5h —${RST}"
fi

if [ "$s_pct" != "-" ]; then
  seg="${seg}   $(color_for "$s_pct")7d $(int "$s_pct")%${RST}"
fi

if [ "$c_pct" != "-" ]; then
  seg="${seg}   $(color_for "$c_pct")ctx $(int "$c_pct")%${RST}"
  [ "$c_tok" != "-" ] && [ "$c_size" != "-" ] &&
    seg="${seg} ${DIM}$(ktok "$c_tok")/$(ktok "$c_size")${RST}"
else
  seg="${seg}   ${DIM}ctx —${RST}"
fi

if [ "$cost_usd" != "-" ]; then
  # Captured before use: the old `printf || printf '0.00'` fallback appended a
  # second number when the first one failed, printing "$0.008.34" rather than
  # nothing. A cost that will not parse is dropped instead.
  money=$(printf '%.2f' "$cost_usd" 2>/dev/null) || money=""
  [ -n "$money" ] && seg="${seg}   ${DIM}\$${money}${RST}"
fi

printf '%s\n' "$seg"
exit 0
